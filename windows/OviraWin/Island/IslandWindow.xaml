<Window x:Class="Ovira.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Ovira.Core"
        xmlns:island="clr-namespace:Ovira.Island"
        Title="Ovira" Width="720" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Focusable="False" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Canvas x:Name="Root">
        <Grid x:Name="Island" Canvas.Top="0" Canvas.Left="0" Width="720" Height="320" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PeekScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- 0.4.2: no drop shadow — on a transparent window it was redrawn by
                 the processor on every frame of the bars -->
            <Path x:Name="Shape" Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <!-- 0.8.5: the second island's own shape, so each one grows on its own under the pointer -->
            <Path x:Name="BubbleShape" Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <!-- 0.6.2: the second island on the right (a timer, a call… while music plays) -->
            <Grid x:Name="BubbleLayer" HorizontalAlignment="Left" VerticalAlignment="Top" Height="35" Opacity="0"
                  Background="Transparent" Cursor="Hand" ClipToBounds="True">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <core:IconView x:Name="BubbleIcon" Icon="timer" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BubbleText" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>

            <Canvas x:Name="ContentHost" HorizontalAlignment="Left" VerticalAlignment="Top">

                <!-- Closed: cover in the left wing, the camera space, bars in the right wing (as on the Mac) -->
                <Grid x:Name="CompactLayer" Height="35" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactArt" Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF202020">
                        <core:IconView x:Name="CompactArtPlaceholder" Icon="music.note" Width="10" Height="10" Fill="#B3FFFFFF" />
                    </Border>
                    <island:SpectrumBars x:Name="CompactBars" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         BarWidth="2.2" BarSpacing="1.7" BarMaxHeight="16" Margin="0,0,6,0" />
                </Grid>

                <!-- Banner: icon on the left, text and level on the right -->
                <Grid x:Name="BannerLayer" Height="35" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <core:IconView x:Name="BannerIcon" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="BannerText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- 0.4.5: the short word on the right of the eye break («Вдаль», «Готово») -->
                    <TextBlock x:Name="BannerRight" Grid.Column="2" FontSize="15" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="8,0,16,0" Visibility="Collapsed" />
                    <Grid x:Name="BannerLevel" Grid.Column="2" Width="86" Height="5" Margin="8,0,16,0" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#38FFFFFF" />
                        <Border x:Name="BannerLevelFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <!-- 0.4.4: a countdown on the right — seconds on top, a bar that runs out below -->
                    <StackPanel x:Name="BannerTimer" Grid.Column="2" Width="28" Margin="8,0,16,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="BannerSeconds" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,-3,0,1" />
                        <Grid Height="3">
                            <Border CornerRadius="1.5" Background="#38FFFFFF" />
                            <Border x:Name="BannerTimerFill" CornerRadius="1.5" Background="White" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BannerTimerScale" ScaleX="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Open: the media player, laid out like the Mac one -->
                <Grid x:Name="ExpandedLayer" Opacity="0">
                    <!-- the cover's colours glowing softly behind -->
                    <Border x:Name="Glow" CornerRadius="26" Height="170" VerticalAlignment="Top" Opacity="0.32" Margin="8,-10,8,0">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <StackPanel Margin="23,16,23,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ExpandedArt" Width="72" Height="72" CornerRadius="13" Background="#FF202020">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ArtGlow" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.55" />
                                </Border.Effect>
                                <core:IconView x:Name="ExpandedArtPlaceholder" Icon="music.note" Width="28" Height="28" Fill="#B3FFFFFF" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SongTitle" Foreground="White" FontSize="15" FontWeight="Bold"
                                           FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SongArtist" Foreground="#B3FFFFFF" FontSize="12.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <island:SpectrumBars x:Name="ExpandedBars" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 BarWidth="2.8" BarSpacing="2.1" BarMaxHeight="26" />
                        </Grid>

                        <!-- progress: thin capsule, times under it -->
                        <Grid x:Name="ProgressTrack" Height="16" Margin="0,9,0,0" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="OnSeekDown" MouseMove="OnSeekMove" MouseLeftButtonUp="OnSeekUp">
                            <Border CornerRadius="2" Height="4" Background="#38FFFFFF" VerticalAlignment="Center" />
                            <Border x:Name="ProgressFill" CornerRadius="2" Height="4" Background="White"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <TextBlock x:Name="TimeElapsed" Foreground="#87FFFFFF" FontSize="9" />
                            <TextBlock x:Name="TimeTotal" Foreground="#87FFFFFF" FontSize="9" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- controls -->
                        <Grid Margin="0,2,0,0" Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource IslandButton}" Width="44" Height="44" Click="OnPrevious" Margin="0,0,14,0">
                                    <island:SkipGlyph x:Name="PrevGlyph" Forward="False" GlyphSize="20" />
                                </Button>
                                <Button Style="{StaticResource IslandButton}" Width="46" Height="44" Click="OnPlayPause">
                                    <island:PlayPauseGlyph x:Name="PlayGlyph" Width="27" Height="27" />
                                </Button>
                                <Button Style="{StaticResource IslandButton}" Width="44" Height="44" Click="OnNext" Margin="14,0,0,0">
                                    <island:SkipGlyph x:Name="NextGlyph" Forward="True" GlyphSize="20" />
                                </Button>
                            </StackPanel>
                            <!-- 0.4.14: «Сохранить» — the Mac's star with its pop and ring -->
                            <Button x:Name="SaveButton" Grid.Column="0" Style="{StaticResource IslandButton}" Width="30" Height="44"
                                    Click="OnSave" ToolTip="Сохранить песню">
                                <Grid Width="30" Height="30">
                                    <Ellipse x:Name="SaveRing" Width="27" Height="27" StrokeThickness="1.5" Stroke="White" Opacity="0"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="SaveRingScale" ScaleX="0.55" ScaleY="0.55" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <core:IconView x:Name="SaveStar" Icon="star.outline" Width="20" Height="20" Fill="#D6FFFFFF"
                                                   RenderTransformOrigin="0.5,0.5">
                                        <core:IconView.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="SaveStarScale" />
                                                <RotateTransform x:Name="SaveStarTurn" />
                                            </TransformGroup>
                                        </core:IconView.RenderTransform>
                                    </core:IconView>
                                </Grid>
                            </Button>
                            <Button x:Name="OutputButton" Grid.Column="4" Style="{StaticResource IslandButton}" Width="30" Height="44"
                                    Click="OnOutputs" ToolTip="Куда идёт звук">
                                <core:IconView x:Name="OutputIcon" Icon="speaker.wave" Width="18" Height="18" Fill="White" />
                            </Button>
                        </Grid>

                        <!-- volume -->
                        <Grid x:Name="VolumeRow" Margin="0,2,0,0" Height="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <core:IconView Icon="speaker" Width="11" Height="11" Fill="#99FFFFFF" />
                            <Grid x:Name="VolumeTrack" Grid.Column="1" Margin="9,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="OnVolumeDown" MouseMove="OnVolumeMove" MouseLeftButtonUp="OnVolumeUp">
                                <Border CornerRadius="2" Height="4" Background="#38FFFFFF" VerticalAlignment="Center" />
                                <Border x:Name="VolumeFill" CornerRadius="2" Height="4" Background="#E6FFFFFF"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                            </Grid>
                            <core:IconView Grid.Column="2" Icon="speaker.wave" Width="13" Height="13" Fill="#99FFFFFF" />
                        </Grid>
                    </StackPanel>

                    <!-- The list of sound outputs, over the whole card -->
                    <Grid x:Name="OutputList" Visibility="Collapsed" Background="Black" Margin="18,14,18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,0,6">
                            <TextBlock Text="Куда идёт звук" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IslandButton}" Width="32" Height="28" HorizontalAlignment="Right"
                                    Click="OnOutputsClose" ToolTip="Назад">
                                <core:IconView Icon="xmark" Width="12" Height="12" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="OutputItems" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
                <!-- 0.5.0: a live activity opened — a call, the timer, the stopwatch, an alarm -->
                <StackPanel x:Name="ActivityLayer" Opacity="0">
                    <Grid Margin="20,14,16,14" Height="76">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ActivityIconBox" Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center">
                            <core:IconView x:Name="ActivityIcon" Icon="timer" Width="22" Height="22" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivityTitle" Foreground="#A6FFFFFF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActivityBig" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,-2,0,0"
                                       Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ActivityC" Style="{StaticResource IslandButton}" Width="40" Height="44" Margin="0,0,6,0"
                                    Click="OnActivityC" ToolTip="К плееру">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#1FFFFFFF">
                                    <core:IconView Icon="music.note" Width="17" Height="17" />
                                </Border>
                            </Button>
                            <Button x:Name="ActivityA" Style="{StaticResource IslandButton}" Width="48" Height="48" Margin="0,0,8,0" Click="OnActivityA">
                                <Border x:Name="ActivityABg" Width="46" Height="46" CornerRadius="23" Background="#33FFFFFF">
                                    <core:IconView x:Name="ActivityAIcon" Icon="pause" Width="20" Height="20" />
                                </Border>
                            </Button>
                            <Button x:Name="ActivityB" Style="{StaticResource IslandButton}" Width="48" Height="48" Click="OnActivityB">
                                <Border x:Name="ActivityBBg" Width="46" Height="46" CornerRadius="23" Background="#FFFF3B30">
                                    <core:IconView x:Name="ActivityBIcon" Icon="xmark" Width="18" Height="18" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- 0.5.1: details of a long job (a Steam download): progress and figures -->
                    <StackPanel x:Name="ActivityDetails" Margin="20,-4,20,14" Visibility="Collapsed">
                        <Grid Height="5" Margin="0,0,0,10">
                            <Border CornerRadius="2.5" Background="#2EFFFFFF" />
                            <Border x:Name="ActivityProgress" CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="ActivityProgressScale" ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <UniformGrid x:Name="ActivityFigures" Columns="3" />
                    </StackPanel>
                </StackPanel>
            </Canvas>
        </Grid>
    </Canvas>
</Window>

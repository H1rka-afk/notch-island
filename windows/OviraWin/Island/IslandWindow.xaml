<Window x:Class="Ovira.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ovira" Width="720" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Focusable="False" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Canvas x:Name="Root">
        <!-- Everything that grows and shrinks — the black shape and the
             contents, clipped to it. Scales a little on hover («peek»). -->
        <Grid x:Name="Island" Canvas.Top="0" Canvas.Left="0" Width="720" Height="300" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PeekScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Path x:Name="Shape" Fill="Black" IsHitTestVisible="True">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" />
                </Path.Effect>
            </Path>

            <Canvas x:Name="ContentHost" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">

                <!-- Closed: cover · title · live bars -->
                <Grid x:Name="CompactLayer" Height="34" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactArt" Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF222222" ClipToBounds="True">
                        <Image x:Name="CompactArtImage" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock x:Name="CompactTitle" Grid.Column="1" Foreground="#E6FFFFFF" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="Bars" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Height="16" />
                </Grid>

                <!-- Banner: icon · text (volume, charging, sound output) -->
                <Grid x:Name="BannerLayer" Height="34" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BannerIcon" Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock x:Name="BannerText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Grid x:Name="BannerLevel" Grid.Column="2" Width="90" Height="5" Margin="8,0,16,0" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#33FFFFFF" />
                        <Border x:Name="BannerLevelFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </Grid>

                <!-- Open: the media player -->
                <Grid x:Name="ExpandedLayer" Opacity="0" Margin="22,20,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="12" Background="#FF222222" ClipToBounds="True">
                            <Image x:Name="ExpandedArt" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,2,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SongTitle" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SongArtist" Foreground="#A6FFFFFF" FontSize="12.5" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SongSource" Foreground="#66FFFFFF" FontSize="11" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="ExpandedBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Height="20" Margin="0,0,4,0" />
                    </Grid>

                    <!-- Progress -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeElapsed" Foreground="#A6FFFFFF" FontSize="10.5" VerticalAlignment="Center" />
                        <Grid x:Name="ProgressTrack" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="OnSeek">
                            <Border CornerRadius="2.5" Height="5" Background="#33FFFFFF" VerticalAlignment="Center" />
                            <Border x:Name="ProgressFill" CornerRadius="2.5" Height="5" Background="White"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                        </Grid>
                        <TextBlock x:Name="TimeTotal" Grid.Column="2" Foreground="#A6FFFFFF" FontSize="10.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Controls, or the list of sound outputs -->
                    <Grid Grid.Row="2" Margin="0,6,0,0" Height="46">
                        <Grid x:Name="Controls">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="2" Style="{StaticResource IslandButton}" Width="56" Height="46" Click="OnPrevious"
                                    ToolTip="Предыдущий">
                                <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="20" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource IslandButton}" Width="60" Height="46" Click="OnPlayPause"
                                    ToolTip="Играть / пауза">
                                <Grid>
                                    <TextBlock x:Name="PauseGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><ScaleTransform /></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                               RenderTransformOrigin="0.5,0.5" Opacity="0">
                                        <TextBlock.RenderTransform><ScaleTransform ScaleX="0.3" ScaleY="0.3" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource IslandButton}" Width="56" Height="46" Click="OnNext"
                                    ToolTip="Следующий">
                                <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="20" />
                            </Button>
                            <Button x:Name="OutputButton" Grid.Column="6" Style="{StaticResource IslandButton}" Width="46" Height="46"
                                    Click="OnOutputs" ToolTip="Куда идёт звук">
                                <TextBlock x:Name="OutputGlyph" Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="#CCFFFFFF" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- The list of sound outputs, over the whole card -->
                    <Grid x:Name="OutputList" Grid.RowSpan="3" Visibility="Collapsed" Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,0,6">
                            <TextBlock Text="Куда идёт звук" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IslandButton}" Width="32" Height="28" HorizontalAlignment="Right"
                                    Click="OnOutputsClose" ToolTip="Назад">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="OutputItems" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Canvas>
        </Grid>
    </Canvas>
</Window>

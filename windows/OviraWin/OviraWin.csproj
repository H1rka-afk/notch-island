<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ovira for Windows 11 — the island at the top of the screen, a media
       player, volume, battery and a settings window. WPF on .NET 8 with the
       Windows 11 SDK projections (media sessions, battery). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ovira</RootNamespace>
    <AssemblyName>Ovira</AssemblyName>
    <ApplicationIcon>Assets\Ovira.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.7.1</Version>
    <Product>Ovira</Product>
    <Company>Ovira</Company>
    <Copyright>Ovira</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- One .exe that runs without installing .NET. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 0.4.12: compiled ahead of time — no warm-up work for the processor
         after every start; a calm garbage collector without extra threads -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Ovira.ico" />
  </ItemGroup>

</Project>

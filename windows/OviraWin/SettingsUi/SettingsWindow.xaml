<Window x:Class="Ovira.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Ovira.Core"
        xmlns:island="clr-namespace:Ovira.Island"
        Title="Ovira" Width="960" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Base}" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Fg}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/Ovira.ico">
    <!-- 0.2.0: the Mac settings, redrawn for Windows — a living colour
         background, a floating glass sidebar, a glossy banner per section with
         the island acting it out, and glass cards. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SectionAccent" Color="#FF3478F6" />
        <!-- Theme colours (0.4.0): replaced from code for light and dark themes -->
        <SolidColorBrush x:Key="Base" Color="#FF0E0E12" />
        <SolidColorBrush x:Key="Dim" Color="#99101014" />
        <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Fg2" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="Fg3" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="CardBg" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="Divider" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="FieldBg" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="FieldBorder" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ButtonBg" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="ButtonHover" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="ButtonPressed" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="SwitchOff" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="TrackBg" Color="#33FFFFFF" />

        <!-- macOS-style switch, in the section's colour -->
        <Style x:Key="MacSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="34" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource SwitchOff}" />
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SectionAccent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="14" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS push button -->
        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Padding="12,4" Background="{DynamicResource ButtonBg}" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0" />
                                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar buttons -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice with a sliding look -->
        <Style x:Key="MacSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Padding="14,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SectionAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: thin track, accent fill, white knob -->
        <Style x:Key="MacSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="18" Height="18" Fill="White">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.35" /></Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MacSliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBg}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider over a colour gradient (theme editor) -->
        <Style x:Key="GradientSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="10" CornerRadius="5" Background="{TemplateBinding Background}" VerticalAlignment="Center"
                                    BorderBrush="#33000000" BorderThickness="0.5" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain text field -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldBorder}"
                                BorderThickness="1" Padding="9,6">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource Fg3}" IsHitTestVisible="False"
                                           x:Name="Placeholder" Visibility="Collapsed" TextWrapping="Wrap" />
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 0.4.2: slim scroll bar like on the Mac, no grey track and arrows -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Knob" Width="5" CornerRadius="2.5" Background="{DynamicResource Fg3}"
                                                        Opacity="0.45" HorizontalAlignment="Center" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Opacity" Value="0.85" />
                                                        <Setter TargetName="Knob" Property="Width" Value="7" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Knob" Property="Opacity" Value="0.95" />
                                                        <Setter TargetName="Knob" Property="Width" Value="7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group: UPPERCASE title, glass card, hint below -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="Margin" Value="6,0,0,7" />
        </Style>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4DFFFFFF" Offset="0" />
                        <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                        <GradientStop Color="#1AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,7,6,0" />
        </Style>
        <Style x:Key="Group" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,9,14,9" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
            <Setter Property="Margin" Value="16,0,12,0" />
        </Style>
        <Style x:Key="SideHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="Margin" Value="10,12,0,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Base}">
        <Grid>
            <!-- Living colour background: the section's colour and the cover's -->
            <!-- 0.4.2: living background like the Mac — a small picture of
                 drifting colour clouds, drawn by code ~30 times a second and
                 stretched smoothly over the window (it is soft anyway) -->
            <Image x:Name="Aurora" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="Linear" />
            <Border Background="{DynamicResource Dim}" IsHitTestVisible="False" />

            <DockPanel>
                <!-- Top bar: Ovira or «‹ Все настройки», search, the live island -->
                <Grid DockPanel.Dock="Top" Height="58" Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <StackPanel x:Name="HomeHeader" Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Ovira.ico" Width="30" Height="30">
                                <Image.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25" /></Image.Effect>
                            </Image>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ovira" FontSize="15" FontWeight="Black" FontFamily="{StaticResource DisplayFont}" />
                                <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="{DynamicResource Fg2}" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="BackButton" CornerRadius="14" Padding="12,6" Cursor="Hand" Visibility="Collapsed"
                                BorderThickness="0.8" BorderBrush="#4DFFFFFF" WindowChrome.IsHitTestVisibleInChrome="True"
                                MouseLeftButtonUp="OnBack">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="BackA" Color="#FF5C9BFF" Offset="0" />
                                    <GradientStop x:Name="BackB" Color="#FF3D85FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect x:Name="BackGlow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4" Color="#FF3D85FF" /></Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <core:IconView Icon="chevron.left" Width="11" Height="11" VerticalAlignment="Center" />
                                <TextBlock Text="Все настройки" FontSize="12.5" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Search -->
                    <Border Grid.Column="2" Width="230" Height="30" CornerRadius="15" Background="{DynamicResource FieldBg}"
                            BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Margin="11,0">
                            <core:IconView Icon="magnifier" Width="12" Height="12" Fill="{DynamicResource Fg2}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Поиск" Margin="19,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox" Margin="16,0,0,0" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}" FontSize="12.5" VerticalAlignment="Center"
                                     TextChanged="OnSearch" />
                        </Grid>
                    </Border>

                    <!-- The island in miniature, as it is right now -->
                    <Border x:Name="TopIsland" Grid.Column="3" Height="36" CornerRadius="18" Background="Black" Padding="12,0"
                            BorderBrush="#1AFFFFFF" BorderThickness="1" VerticalAlignment="Center">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="4" Direction="270" Opacity="0.3" /></Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="TopArt" Width="22" Height="22" CornerRadius="6" Background="#FF2A2A2A" VerticalAlignment="Center" />
                            <StackPanel x:Name="TopText" Margin="8,0,8,0" VerticalAlignment="Center" MaxWidth="120">
                                <TextBlock x:Name="TopTitle" Foreground="White" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TopArtist" FontSize="9.5" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <island:SpectrumBars x:Name="TopBars" VerticalAlignment="Center" BarWidth="2" BarSpacing="1.5" BarMaxHeight="14" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,8,0,0">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Свернуть">
                            <core:IconView Icon="minus" Width="10" Height="10" Fill="{DynamicResource Fg2}" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnClose" ToolTip="Закрыть">
                            <core:IconView Icon="xmark" Width="10" Height="10" Fill="{DynamicResource Fg2}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid>
                    <!-- Home: the stage with the island, and bright tiles -->
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,4,24,26">
                            <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Margin="0,0,0,18">
                                <TextBlock Text="НАЙДЕНО" Style="{StaticResource GroupTitle}" />
                                <Border Style="{StaticResource GlassCard}" Padding="8">
                                    <StackPanel x:Name="SearchResults" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="HomeContent">
                                <!-- Stage -->
                                <Grid Margin="0,0,0,18">
                                <Border x:Name="Stage" Height="176" CornerRadius="26" ClipToBounds="True" BorderThickness="1"
                                        BorderBrush="#47FFFFFF">
                                    <Border.Effect><DropShadowEffect x:Name="StageGlow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#FF5C59E6" /></Border.Effect>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="StageA" Color="#D95C59E6" Offset="0" />
                                            <GradientStop Color="#FF1F1440" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Border x:Name="StageTint" CornerRadius="26" IsHitTestVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.9" RadiusY="1.2">
                                                    <GradientStop x:Name="StageTintColor" Color="#99FF4566" Offset="0" />
                                                    <GradientStop Color="#00FF4566" Offset="1" />
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="26" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                                                    <GradientStop Color="#29FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock x:Name="StageCaption" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                            <TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3" /></TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <!-- The stage's top edge is the screen's top edge: the island
                                     sits over the frame line, as on the Mac -->
                                <Canvas x:Name="StageCanvas" Height="176" VerticalAlignment="Top" IsHitTestVisible="False">
                                    <Path x:Name="StageShape" Fill="Black">
                                        <Path.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.35" /></Path.Effect>
                                    </Path>
                                    <Grid x:Name="StageContent" Height="35" Canvas.Top="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="StageArt" Width="22" Height="22" CornerRadius="6" Background="#FF2A2A2A" />
                                        <core:IconView x:Name="StageIcon" Width="16" Height="16" />
                                        <!-- 0.4.8: never text in the middle — the word sits on the right -->
                                        <TextBlock x:Name="StageText" Foreground="White" Grid.Column="2" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="8,0,16,0" />
                                        <Grid x:Name="StageLevel" Grid.Column="2" Width="86" Height="5" Margin="8,0,16,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Border CornerRadius="2.5" Background="#38FFFFFF" />
                                            <Border x:Name="StageLevelFill" CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="StageLevelScale" ScaleX="0" /></Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <island:SpectrumBars x:Name="StageBars" Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center"
                                                             BarWidth="2.2" BarSpacing="1.7" BarMaxHeight="16" />
                                    </Grid>
                                </Canvas>
                                </Grid>
                                <!-- Bento tiles -->
                                <Grid x:Name="Tiles">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="150" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- One section -->
                    <ScrollViewer x:Name="DetailView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="Detail" Margin="30,4,30,30">
                            <Border x:Name="Hero" CornerRadius="26" Padding="22,20" Margin="0,0,0,26" BorderThickness="1"
                                    BorderBrush="#59FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="HeroGlow" BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.35" Color="#FF3478F6" />
                                </Border.Effect>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="HeroA" Color="#EB3478F6" Offset="0" />
                                        <GradientStop x:Name="HeroB" Color="#8C3478F6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" Margin="-22,-20,-22,-20" CornerRadius="26" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.55">
                                                <GradientStop Color="#4DFFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="HeroTileHost" Width="60" Height="60" />
                                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeroTitle" Foreground="White" FontSize="28" FontWeight="Black" FontFamily="{StaticResource DisplayFont}" />
                                        <TextBlock x:Name="HeroSubtitle" FontSize="12.5" FontWeight="Medium" Foreground="#D1FFFFFF"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="PageHost" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
            <!-- 0.4.1: a snapshot of the old theme that fades out over the new one -->
            <Image x:Name="ThemeFade" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>

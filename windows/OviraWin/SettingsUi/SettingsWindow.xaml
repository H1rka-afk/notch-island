<Window x:Class="Ovira.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ovira" Width="940" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FF101014" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{StaticResource UiFont}" Foreground="White" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/Ovira.ico">
    <!-- 0.2.0: the Mac settings, redrawn for Windows — a living colour
         background, a floating glass sidebar, a glossy banner per section with
         the island acting it out, and glass cards. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SectionAccent" Color="#FF3478F6" />

        <!-- macOS-style switch, in the section's colour -->
        <Style x:Key="MacSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="34" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="#3DFFFFFF" />
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SectionAccent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="14" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS push button -->
        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Padding="12,4" Background="#2EFFFFFF" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0" />
                                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar buttons -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice with a sliding look -->
        <Style x:Key="MacSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Padding="14,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SectionAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: thin track, accent fill, white knob -->
        <Style x:Key="MacSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="18" Height="18" Fill="White">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.35" /></Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MacSliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group: UPPERCASE title, glass card, hint below -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Margin" Value="6,0,0,7" />
        </Style>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4DFFFFFF" Offset="0" />
                        <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                        <GradientStop Color="#1AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,7,6,0" />
        </Style>
        <Style x:Key="Group" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,9,14,9" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Margin" Value="16,0,12,0" />
        </Style>
        <Style x:Key="SideHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Margin" Value="10,12,0,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="12" ClipToBounds="True" Background="#FF101014">
        <Grid>
            <!-- Living colour background (section colour + the cover's colour) -->
            <Canvas x:Name="Aurora" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="BlobA" Width="620" Height="520" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="BlobAColor" Color="#FF3478F6" Offset="0" />
                            <GradientStop Color="#003478F6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="BlobB" Width="560" Height="480" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="BlobBColor" Color="#FFFF4566" Offset="0" />
                            <GradientStop Color="#00FF4566" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="BlobC" Width="500" Height="440" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="BlobCColor" Color="#FF8E5BFF" Offset="0" />
                            <GradientStop Color="#008E5BFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
            <Border Background="#8C0C0C10" IsHitTestVisible="False" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Floating glass sidebar -->
                <Border Margin="10,10,0,10" CornerRadius="22" Background="#1CFFFFFF" BorderThickness="1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#59FFFFFF" Offset="0" />
                            <GradientStop Color="#0AFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <DockPanel Margin="8,14,8,10">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,0,12">
                            <Image Source="pack://application:,,,/Assets/Ovira.ico" Width="36" Height="36">
                                <Image.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.3" /></Image.Effect>
                            </Image>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ovira" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                                <TextBlock x:Name="VersionText" FontSize="11" Foreground="#8CFFFFFF" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Search -->
                        <Border DockPanel.Dock="Top" Margin="2,0,2,10" CornerRadius="9" Background="#14FFFFFF" Height="30"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid Margin="9,0">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="#8CFFFFFF" VerticalAlignment="Center" />
                                <TextBlock x:Name="SearchPlaceholder" Text="Поиск" Margin="20,0,0,0" FontSize="12.5"
                                           Foreground="#73FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox" Margin="17,0,0,0" Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="White" FontSize="12.5" VerticalAlignment="Center"
                                         TextChanged="OnSearch" />
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <Grid>
                                <StackPanel x:Name="NavList" />
                                <StackPanel x:Name="SearchResults" Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Title-bar buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,6,8,0" Panel.ZIndex="5">
                    <Button Style="{StaticResource CaptionButton}" Tag="&#xE921;" Click="OnMinimize" ToolTip="Свернуть" />
                    <Button Style="{StaticResource CaptionButton}" Tag="&#xE8BB;" Click="OnClose" ToolTip="Закрыть" />
                </StackPanel>

                <!-- Detail -->
                <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,40,0,0">
                    <StackPanel x:Name="Detail" Margin="30,4,30,30">
                        <!-- Hero banner -->
                        <Border x:Name="Hero" CornerRadius="26" Padding="22,20" Margin="0,0,0,26" BorderThickness="1"
                                BorderBrush="#59FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect x:Name="HeroGlow" BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.4" Color="#FF3478F6" />
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="HeroA" Color="#EB3478F6" Offset="0" />
                                    <GradientStop x:Name="HeroB" Color="#8C3478F6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- gloss -->
                                <Border Grid.ColumnSpan="3" Margin="-22,-20,-22,-20" CornerRadius="26" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.55">
                                            <GradientStop Color="#4DFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="HeroTile" Width="60" Height="60" CornerRadius="17" BorderThickness="1" BorderBrush="#40FFFFFF">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="HeroTileGlow" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.6" Color="#FF3478F6" />
                                    </Border.Effect>
                                    <Grid>
                                        <Border x:Name="HeroTileFill" CornerRadius="16" Background="#FF3478F6" />
                                        <Border CornerRadius="16">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                                                    <GradientStop Color="#59FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock x:Name="HeroIcon" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroTitle" FontSize="28" FontWeight="Black" FontFamily="{StaticResource DisplayFont}" />
                                    <TextBlock x:Name="HeroSubtitle" FontSize="12.5" FontWeight="Medium" Foreground="#D1FFFFFF"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- the island acting out the section -->
                                <Border Grid.Column="2" Width="236" Height="96" CornerRadius="18" ClipToBounds="True"
                                        BorderThickness="1" BorderBrush="#38FFFFFF">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#52000000" Offset="0" />
                                            <GradientStop Color="#1F000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Canvas x:Name="PreviewCanvas" Width="236" Height="96">
                                        <Path x:Name="PreviewShape" Fill="Black" />
                                        <Grid x:Name="PreviewContent" Height="26" Canvas.Top="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="PreviewArtBox" Width="16" Height="16" CornerRadius="4" Background="#FF2A2A2A"
                                                    ClipToBounds="True">
                                                <Image x:Name="PreviewArt" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock x:Name="PreviewIcon" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PreviewText" Grid.Column="1" FontSize="10" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel x:Name="PreviewBars" Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Height="12" />
                                        </Grid>
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Section pages are filled from code (one builder for all rows). -->
                        <StackPanel x:Name="PageHost" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
